# worsegestalt — environment for the xtool WSL setup (README «Установка из WSL»).
#
# Apple Mobile Device Service on Windows listens on 127.0.0.1:27015; a netsh
# portproxy forwards <WSL-gateway>:27015 → 127.0.0.1:27015. The gateway is the
# Windows-side host IP as seen from WSL (ip route list default).
USBMUXD_SOCKET_ADDRESS="$(ip route list default | awk '{print $3}'):27015"
